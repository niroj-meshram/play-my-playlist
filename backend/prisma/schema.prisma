// Play My Playlist — database schema.
// Domain models are added per milestone with versioned migrations (never `prisma db push`).
// Target model: docs/architecture.md §3.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────────

/// Anonymous guest identity. One per browser session family.
model User {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String   @db.VarChar(24)
  avatarId    String   @db.VarChar(32)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    AuthSession[]
  roomPlayers RoomPlayer[]
}

/// Refresh-token session. Only SHA-256 hashes of tokens are stored.
model AuthSession {
  /// Generated by the application: it is embedded in the refresh token.
  id                String    @id @db.Uuid
  userId            String    @db.Uuid
  refreshTokenHash  String    @unique @db.Char(64)
  /// Previous token, accepted for a short grace window to absorb concurrent refreshes.
  previousTokenHash String?   @db.Char(64)
  rotatedAt         DateTime?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Rooms ───────────────────────────────────────────────────────────────────

enum RoomStatus {
  LOBBY
  IN_GAME
  CLOSED
}

enum RoomVisibility {
  INVITE_ONLY
}

enum RoomPlayerStatus {
  ACTIVE
  LEFT
}

model Room {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique @db.Char(6)
  status         RoomStatus     @default(LOBBY)
  visibility     RoomVisibility @default(INVITE_ONLY)
  maxPlayers     Int            @db.SmallInt
  roundCount     Int            @db.SmallInt
  hostPlayerId   String?        @unique @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastActivityAt DateTime       @default(now())

  hostPlayer     RoomPlayer?     @relation("RoomHost", fields: [hostPlayerId], references: [id], onDelete: SetNull)
  players        RoomPlayer[]    @relation("RoomPlayers")
  playlists      Playlist[]
  playlistTracks PlaylistTrack[]
  games          Game[]

  @@index([status, lastActivityAt])
}

/// A user's membership in one room. Leaving keeps the row (status LEFT) so rejoining reuses it.
model RoomPlayer {
  id          String           @id @default(uuid()) @db.Uuid
  roomId      String           @db.Uuid
  userId      String           @db.Uuid
  displayName String           @db.VarChar(24)
  avatarId    String           @db.VarChar(32)
  status      RoomPlayerStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?

  room       Room              @relation("RoomPlayers", fields: [roomId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostedRoom Room?             @relation("RoomHost")
  /// PRIVATE: never select this relation on a public read path except for `status`.
  playlist   Playlist?
  games      GameParticipant[]

  @@unique([roomId, userId])
  @@index([roomId, status, joinedAt])
}

// ─── Playlists ───────────────────────────────────────────────────────────────

enum PlaylistStatus {
  PROCESSING
  READY
  REJECTED
}

enum PlaylistTrackStatus {
  PLAYABLE
  /// Already PLAYABLE in another READY playlist of the room when this one was ingested (D6).
  DUPLICATE
  /// The leader's player reported it cannot be embedded or no longer exists (YouTube error 100/101/150).
  UNPLAYABLE
}

/// A player's submission. The roomPlayerId link, sourceUrl and title are PRIVATE until the reveal.
model Playlist {
  id                  String         @id @default(uuid()) @db.Uuid
  roomId              String         @db.Uuid
  roomPlayerId        String         @unique @db.Uuid
  youtubePlaylistId   String         @db.VarChar(64)
  sourceUrl           String         @db.VarChar(2048)
  title               String?        @db.VarChar(200)
  status              PlaylistStatus @default(PROCESSING)
  rejectionCode       String?        @db.VarChar(40)
  playableCount       Int            @default(0)
  duplicateCount      Int            @default(0)
  /// Changes on every submission; a background job whose ID no longer matches is discarded.
  submissionId        String         @db.Uuid
  attempts            Int            @default(0) @db.SmallInt
  submittedAt         DateTime       @default(now())
  processingStartedAt DateTime?
  readyAt             DateTime?
  updatedAt           DateTime       @updatedAt

  room       Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomPlayer RoomPlayer      @relation(fields: [roomPlayerId], references: [id], onDelete: Cascade)
  tracks     PlaylistTrack[]
  gameUses   GamePlaylist[]

  @@index([roomId, status])
  @@index([status, processingStartedAt])
}

/// Playable songs of a playlist. Unplayable videos are never stored.
model PlaylistTrack {
  id             String              @id @default(uuid()) @db.Uuid
  playlistId     String              @db.Uuid
  roomId         String              @db.Uuid
  youtubeVideoId String              @db.VarChar(16)
  title          String              @db.VarChar(200)
  artist         String?             @db.VarChar(200)
  thumbnailUrl   String?             @db.VarChar(512)
  durationSec    Int
  position       Int
  status         PlaylistTrackStatus

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([playlistId, youtubeVideoId])
  @@index([roomId, youtubeVideoId])
}

enum GamePhase {
  PLAYING
  DISCUSSION
  VOTING
  REVEAL
  SCOREBOARD
  FINISHED
}

enum GameRoundStatus {
  PENDING
  ACTIVE
  REVEALED
}

enum GameEndReason {
  COMPLETED
  NOT_ENOUGH_PLAYERS
  OUT_OF_SONGS
}

/// One game in a room (rematches create new rows). Phase changes are compare-and-set on
/// (phase, stateVersion), so every transition happens exactly once (docs/architecture.md §4).
/// A partial unique index (migration SQL) allows only one non-FINISHED game per room.
model Game {
  id               String         @id @default(uuid()) @db.Uuid
  roomId           String         @db.Uuid
  gameNumber       Int            @db.SmallInt
  phase            GamePhase
  currentRound     Int            @db.SmallInt
  totalRounds      Int            @db.SmallInt
  stateVersion     Int            @default(0)
  phaseStartedAt   DateTime       @default(now())
  settingsSnapshot Json
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  endReason        GameEndReason?

  room         Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants GameParticipant[]
  playlists    GamePlaylist[]
  rounds       GameRound[]

  @@unique([roomId, gameNumber])
}

/// The players of a game, fixed at start. Score columns are written from M5 on.
model GameParticipant {
  id             String @id @default(uuid()) @db.Uuid
  gameId         String @db.Uuid
  roomPlayerId   String @db.Uuid
  totalScore     Int    @default(0)
  correctGuesses Int    @default(0) @db.SmallInt
  ownerPoints    Int    @default(0)

  game          Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roomPlayer    RoomPlayer    @relation(fields: [roomPlayerId], references: [id], onDelete: Cascade)
  /// PRIVATE until the reveal of a round from this playlist.
  playlist      GamePlaylist?
  votesCast     Vote[]        @relation("VotesCast")
  votesReceived Vote[]        @relation("VotesReceived")
  roundScores   RoundScore[]

  @@unique([gameId, roomPlayerId])
}

/// A participant's playlist as used in one game, under a CSPRNG-shuffled public label.
/// The owner link is PRIVATE: public read paths select only `publicLabel` before the reveal.
model GamePlaylist {
  id                 String  @id @default(uuid()) @db.Uuid
  gameId             String  @db.Uuid
  ownerParticipantId String  @db.Uuid
  /// The lobby playlist the songs came from; cleared if that playlist is deleted.
  sourcePlaylistId   String? @db.Uuid
  publicLabel        String  @db.VarChar(16)

  game           Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  owner          GameParticipant @relation(fields: [ownerParticipantId], references: [id], onDelete: Cascade)
  sourcePlaylist Playlist?       @relation(fields: [sourcePlaylistId], references: [id], onDelete: SetNull)
  rounds         GameRound[]

  @@unique([gameId, publicLabel])
  @@unique([ownerParticipantId])
}

/// One round. The song is copied in, so the game no longer depends on the lobby playlist.
model GameRound {
  id             String          @id @default(uuid()) @db.Uuid
  gameId         String          @db.Uuid
  roundNumber    Int             @db.SmallInt
  gamePlaylistId String          @db.Uuid
  status         GameRoundStatus @default(PENDING)
  youtubeVideoId String          @db.VarChar(16)
  title          String          @db.VarChar(200)
  artist         String?         @db.VarChar(200)
  thumbnailUrl   String?         @db.VarChar(512)
  durationSec    Int
  startedAt      DateTime?
  revealedAt     DateTime?

  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gamePlaylist GamePlaylist @relation(fields: [gamePlaylistId], references: [id], onDelete: Cascade)
  votes        Vote[]
  scores       RoundScore[]

  @@unique([gameId, roundNumber])
  @@unique([gameId, youtubeVideoId])
}

// ─── Voting & scoring ────────────────────────────────────────────────────────

enum RoundScoreReason {
  /// Nobody guessed the owner: the owner scores.
  OWNER_UNGUESSED
  /// Exactly one participant guessed correctly.
  SOLE_CORRECT
  /// Two or more participants guessed correctly.
  SHARED_CORRECT
  /// The owner was offline when voting closed (D12): 0 points, kept for audit and the reveal.
  OWNER_OFFLINE
}

/// One vote per participant per round, final once inserted. PRIVATE until the round is
/// REVEALED: only the count is public while voting is open (docs/architecture.md §6).
/// A CHECK constraint (migration SQL) blocks self-votes.
model Vote {
  id              String   @id @default(uuid()) @db.Uuid
  roundId         String   @db.Uuid
  voterId         String   @db.Uuid
  suspectId       String   @db.Uuid
  /// Null until the reveal, which sets it inside the scoring transaction.
  isCorrect       Boolean?
  /// A retry with the same ID returns the original ack; a different ID is ALREADY_VOTED.
  clientRequestId String   @db.Uuid
  createdAt       DateTime @default(now())

  round   GameRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter   GameParticipant @relation("VotesCast", fields: [voterId], references: [id], onDelete: Cascade)
  suspect GameParticipant @relation("VotesReceived", fields: [suspectId], references: [id], onDelete: Cascade)

  @@unique([roundId, voterId])
}

/// Points awarded in one round: the audit trail behind the GameParticipant totals.
/// UNIQUE (roundId, participantId) makes score allocation idempotent.
model RoundScore {
  id            String           @id @default(uuid()) @db.Uuid
  roundId       String           @db.Uuid
  participantId String           @db.Uuid
  points        Int              @db.SmallInt
  reason        RoundScoreReason

  round       GameRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant GameParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId])
}
